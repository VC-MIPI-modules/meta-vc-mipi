From a1c3e47f6eb1bc9e6469857bac3c4b968d9363cc Mon Sep 17 00:00:00 2001
From: Peter Martienssen <peter.martienssen@liquify-consulting.de>
Date: Mon, 25 May 2026 15:05:30 +0000
Subject: [PATCH] arm64: imx95: Add Vision Components MIPI CSI-2 driver to
 device tree
Upstream-Status: Inappropriate
---
 .../dts/freescale/imx95-var-dart-sonata.dts   | 50 ++++++++-----------
 1 file changed, 22 insertions(+), 28 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx95-var-dart-sonata.dts b/arch/arm64/boot/dts/freescale/imx95-var-dart-sonata.dts
index bd5cf46495d4..0b894c20afb4 100644
--- a/arch/arm64/boot/dts/freescale/imx95-var-dart-sonata.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-var-dart-sonata.dts
@@ -356,21 +356,16 @@ &lpi2c3 {
 	sda-gpios = <&gpio2 29 GPIO_ACTIVE_HIGH>;
 	status = "okay";
 
-	ov5640_mipi0: mipi-camera@3c {
-		compatible = "ovti,ov5640";
-		reg = <0x3c>;
-		clocks = <&clk_ov5640_fixed>;
-		clock-names = "xclk";
-		assigned-clock-rates = <24000000>;
-		powerdown-gpios = <&pca6408_1 3 GPIO_ACTIVE_HIGH>;
-		reset-gpios = <&pca6408_1 1 GPIO_ACTIVE_LOW>;
-		status = "okay";
+	vc_mipi@1a {
+		reg        = <0x1a>;
+		compatible = "vc,vc_mipi";
+		status     = "okay";
 
 		port {
-			ov5640_mipi_0_ep: endpoint {
-				remote-endpoint = <&mipi_csi0_ep>;
-				data-lanes = <1 2>;
-				clock-lanes = <0>;
+			vc_mipi_ep_0: endpoint {
+				clock-lanes      = <0>;
+				data-lanes       = <1 2>;
+				remote-endpoint  = <&mipi_csi0_ep>;
 			};
 		};
 	};
@@ -454,21 +449,20 @@ &lpi2c4 {
 };
 
 &lpi2c8 {
-	ov5640_mipi1: ov5640_mipi1@3c {
-		compatible = "ovti,ov5640";
-		reg = <0x3c>;
-		clocks = <&clk_ov5640_fixed>;
-		clock-names = "xclk";
-		assigned-clock-rates = <24000000>;
-		powerdown-gpios = <&pca6408_1 2 GPIO_ACTIVE_HIGH>;
-		reset-gpios = <&pca6408_1 0 GPIO_ACTIVE_LOW>;
-		status = "okay";
+	wm8904: codec@1a {
+		status = "disable";
+	};
+
+	vc_mipi@1a {
+		reg        = <0x1a>;
+		compatible = "vc,vc_mipi";
+		status     = "okay";
 
 		port {
-			ov5640_mipi_1_ep: endpoint {
-				remote-endpoint = <&mipi_csi1_ep>;
-				data-lanes = <1 2>;
-				clock-lanes = <0>;
+			vc_mipi_ep_1: endpoint {
+				clock-lanes      = <0>;
+				data-lanes       = <1 2>;
+				remote-endpoint  = <&mipi_csi1_ep>;
 			};
 		};
 	};
@@ -575,7 +569,7 @@ ports {
 		port@0 {
 			reg = <0>;
 			mipi_csi0_ep: endpoint {
-				remote-endpoint = <&ov5640_mipi_0_ep>;
+				remote-endpoint = <&vc_mipi_ep_0>;
 				data-lanes = <1 2>;
 				clock-lanes = <0>;
 			};
@@ -600,7 +594,7 @@ ports {
 		port@0 {
 			reg = <0>;
 			mipi_csi1_ep: endpoint {
-				remote-endpoint = <&ov5640_mipi_1_ep>;
+				remote-endpoint = <&vc_mipi_ep_1>;
 				data-lanes = <1 2>;
 				clock-lanes = <0>;
 			};
-- 
2.34.1

